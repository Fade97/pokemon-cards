{
  "name": "pokemon-cards-backend",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "wrangler dev",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && tsc -p tsconfig.json && tsc -p test/tsconfig.json && tsc -p importer/tsconfig.json",
    "test": "vitest run && vitest run --config importer/vitest.config.ts",
    "deploy": "wrangler deploy",
    "importer:build": "esbuild importer/run.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/importer.mjs && cp importer/schema.sql dist/schema.sql",
    "import": "pnpm run importer:build && node --disable-warning=ExperimentalWarning dist/importer.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "dependencies": {
    "aws4fetch": "1.0.20"
  }
}
