<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher. The collection goes into the user's own Android backup, never to an app server (ADR 0006),
     as the JSON snapshot FoilarkBackupAgent writes (data/backup/AndroidBackup.kt): the database is mostly the card
     catalog, which the language packs rebuild, and would push the backup over Android's 25 MB quota.
     The contribution consent is left out: it stays on the phone it was given on, with the withdrawal keys (#253). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="android-backup/" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="contribution_consent.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="android-backup/" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="contribution_consent.xml" />
    </device-transfer>
</data-extraction-rules>
