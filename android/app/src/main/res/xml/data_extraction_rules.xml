<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher. The collection database goes into the user's own Android backup, never to an app server (ADR 0006). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
